# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Runtime generated logs and databases
logs/*.db
logs/*.jsonl
logs/*.log
*.log

# Keep the logs directory in git with .gitkeep
!logs/.gitkeep

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary & Test artifacts
.pytest_cache/
.coverage
htmlcov/
