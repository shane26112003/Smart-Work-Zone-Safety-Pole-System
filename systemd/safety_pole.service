[Unit]
Description=Smart Work-Zone Safety Pole System
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/safety
ExecStart=/home/pi/safety/venv/bin/python main.py --mode hardware
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment variables
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
